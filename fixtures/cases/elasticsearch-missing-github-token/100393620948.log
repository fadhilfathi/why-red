2026-09-02T19:31:43.8518414Z with:
2026-09-02T19:31:43.8534476Z   script: const run = context.payload.workflow_run;
const event = run.event;
const headSha = run.head_sha;
const headBranch = run.head_branch;
const headRepo = run.head_repository.full_name;
const { owner, repo } = context.repo;
const isFork = headRepo !== `${owner}/${repo}`;

core.setOutput('event', event);
core.setOutput('head-sha', headSha);
core.setOutput('head-branch', headBranch);
core.setOutput('head-repo', headRepo);
core.setOutput('is-fork', isFork ? 'true' : 'false');

const pathPattern = process.env.PATH_PATTERN || '**';
const ignoreLines = (process.env.IGNORE_PATTERNS || '')
  .split('\n').map(s => s.trim()).filter(Boolean);

// No checkout in this workflow_run phase, so patterns are matched
// against API filenames: dir/** (subtree), dir/* (direct children), exact.
const matchesGlob = (f, pattern) => {
  if (pattern.endsWith('/**')) return f.startsWith(pattern.slice(0, -3) + '/');
  if (pattern.endsWith('/*')) {
    const dir = pattern.slice(0, -2);
    return f.startsWith(dir + '/') && !f.slice(dir.length + 1).includes('/');
  }
  return f === pattern;
};

// Fails open: any pattern shape other than dir/** matches everything.
const matchesPattern = (filename) =>
  !pathPattern.endsWith('/**') || matchesGlob(filename, pathPattern);

const isIgnored = (filename) => ignoreLines.some(p => matchesGlob(filename, p));

if (event === 'push') {
  core.setOutput('base-ref', headBranch);
  core.setOutput('vale-files-match', 'false');

  let hasChanges = 'true';
  try {
    const { data: commit } = await github.rest.repos.getCommit({
      owner, repo, ref: headSha,
    });
    const commitFiles = commit.files || [];
    // GitHub caps getCommit file list at 300; if truncated, default to has-changes=true.
    if (commitFiles.length >= 300) {
      core.warning('Commit has ≥300 files — change detection truncated, defaulting to has-changes=true');
    } else {
      hasChanges = commitFiles.some(f => matchesPattern(f.filename) && !isIgnored(f.filename)) ? 'true' : 'false';
      core.info(`Push has-changes (commit diff): ${hasChanges}`);

      // Release-branch opt-in parity: a freshly-cut semver branch shares its
      // HEAD with the default branch (no diff) but still needs a build so
      // links.json is produced for the link index.
      const useRelease = process.env.USE_RELEASE_BRANCHES === 'true';
      const defaultBranch = process.env.DEFAULT_BRANCH;
      if (hasChanges === 'false' && useRelease && headBranch !== defaultBranch && /^[0-9]+\.[0-9]+(\.[0-9]+)?$/.test(headBranch)) {
        const cmp = await github.rest.repos.compareCommitsWithBasehead({
          owner, repo, basehead: `${defaultBranch}...${headSha}`,
        });
        if (cmp.data.ahead_by === 0) {
          hasChanges = 'true';
          core.info('Release-branch opt-in: freshly-cut semver branch — forcing has-changes=true');
        }
      }
    }
  } catch (err) {
    core.warning(`Push change detection failed: ${err.message} — defaulting to has-changes=true`);
  }

  core.setOutput('has-changes', hasChanges);
  return;
}

if (event !== 'pull_request') {
  core.info(`Event '${event}' is not deployable — skipping`);
  core.setOutput('has-changes', 'false');
  core.setOutput('vale-files-match', 'false');
  return;
}

// --- PR resolution ---
let prNumber;
if (run.pull_requests?.length > 0) {
  prNumber = run.pull_requests[0].number;
  core.info(`Resolved PR #${prNumber} from workflow_run.pull_requests`);
} else {
  const headLabel = `${run.head_repository.owner.login}:${headBranch}`;
  const { data: prs } = await github.rest.pulls.list({
    owner, repo, state: 'open', head: headLabel
  });
  const match = prs.find(pr => pr.head.sha === headSha);
  if (match) {
    prNumber = match.number;
    core.info(`Resolved PR #${prNumber} via pulls.list fallback`);
  }
}

if (!prNumber) {
  core.warning('Could not resolve PR number — skipping deployment');
  core.setOutput('has-changes', 'false');
  core.setOutput('vale-files-match', 'false');
  return;
}

core.setOutput('pr-number', prNumber);

const { data: pr } = await github.rest.pulls.get({
  owner, repo, pull_number: prNumber
});
core.setOutput('base-ref', pr.base.ref);
core.setOutput('pr-author', pr.user.login);

// --- Changed-files check (docs-relevant files only) ---
const files = await github.paginate(github.rest.pulls.listFiles, {
  owner, repo, pull_number: prNumber
});

const hasChanges = files.some(f => matchesPattern(f.filename) && !isIgnored(f.filename));
core.setOutput('has-changes', hasChanges ? 'true' : 'false');

// --- Vale files check (vale-paths filtering) ---
const valePathLines = (process.env.VALE_PATHS || '')
  .split('\n').map(s => s.trim()).filter(Boolean);

let valeFilesMatch;
if (valePathLines.length === 0) {
  valeFilesMatch = hasChanges;
} else {
  const valeIncludes = valePathLines.filter(p => !p.startsWith('!'));
  const valeExcludes = valePathLines.filter(p => p.startsWith('!')).map(p => p.slice(1));
  const matchesVale = (filename) => {
    const included = valeIncludes.length === 0 || valeIncludes.some(p => matchesGlob(filename, p));
    const excluded = valeExcludes.some(p => matchesGlob(filename, p));
    return included && !excluded;
  };
  valeFilesMatch = files.some(f => matchesVale(f.filename) && !isIgnored(f.filename));
}
core.setOutput('vale-files-match', valeFilesMatch ? 'true' : 'false');

